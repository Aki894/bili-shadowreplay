{
  "build": {
    "beforeBundleCommand": "node scripts/bundle-linux-ffmpeg.mjs"
  },
  "bundle": {
    "resources": {
      "target/ffmpeg-runtime/": "ffmpeg-runtime/"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib": "target/ffmpeg-runtime"
        }
      },
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "libgcc-s1",
          "libstdc++6",
          "libicu74",
          "libharfbuzz0b",
          "libharfbuzz-subset0",
          "libfreetype6",
          "libfontconfig1",
          "libpng16-16t64",
          "libjpeg-turbo8",
          "libexpat1",
          "zlib1g"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "BiliBili ShadowReplay",
        "width": 1300,
        "height": 600,
        "transparent": false,
        "decorations": false
      }
    ]
  }
}
